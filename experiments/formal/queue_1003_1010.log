(.venv) try {
    Write-Host "Running formal preflight..." -ForegroundColor Cyan

    & $pythonPath scripts\check_formal_preflight.py --no-report

    if ($LASTEXITCODE -ne 0) {
        throw "Formal preflight 失败，队列未启动。"
    }

    foreach ($job in $jobs) {
        $row = Get-FormalRow `
            -Method $job.Method `
            -Seed $job.Seed

        if ($row.status -eq "audited") {
            Assert-FormalAudit `
                -Row $row `
                -Method $job.Method `
                -Seed $job.Seed

            Write-Host "SKIP already audited: $($job.Method) $($job.Seed)" `
                -ForegroundColor Yellow
            continue
        }

        if ($row.status -ne "pending") {
            throw "$($job.Method) $($job.Seed) 状态为 $($row.status)，不是 pending；队列停止。"
        }

        if (Test-Path $row.output_directory) {
            throw "输出目录已存在但状态为 pending：$($row.output_directory)"
        }

        Write-Host ""
        Write-Host "==================================================" `
            -ForegroundColor Cyan
        Write-Host "START $($job.Method) seed $($job.Seed)" `
            -ForegroundColor Cyan
        Write-Host "Config: $($row.config_path)"
        Write-Host "Start time: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"
        Write-Host "==================================================" `
            -ForegroundColor Cyan

        & $pythonPath scripts\run_formal.py `
            --config $row.config_path

        $runExitCode = $LASTEXITCODE

        if ($runExitCode -ne 0) {
            throw "$($job.Method) $($job.Seed) 失败，exit code=$runExitCode。队列停止。"
        }

        $row = Get-FormalRow `
            -Method $job.Method `
            -Seed $job.Seed

        Assert-FormalAudit `
            -Row $row `
            -Method $job.Method `
            -Seed $job.Seed

        Write-Host "AUDIT PASSED: $($job.Method) seed $($job.Seed)" `
            -ForegroundColor Green
        Write-Host "End time: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"
    }

    $finishedRows = @(
        Import-Csv $manifestPath |
        Where-Object {
            [int]$_.search_seed -ge 1003 -and
            [int]$_.search_seed -le 1010 -and
            $_.status -eq "audited" -and
            $_.audit_status -eq "passed" -and
            $_.exit_code -eq "0"
        }
    )

    if ($finishedRows.Count -ne 24) {
        throw "最终审计通过的记录应为 24，实际为 $($finishedRows.Count)"
    }

    Write-Host ""
    Write-Host "FORMAL SEEDS 1003-1010: ALL 24 RUNS AUDITED" `
        -ForegroundColor Green
}
catch {
    Write-Host ""
    Write-Host "FORMAL QUEUE STOPPED" -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
    throw
}
